# Your own env vars for this fork's env/app/.env.dev, alongside upstream's
# env/mystic_auth/.env.dev.example. Ships empty; upstream never edits this file
# again. See docs/mystic_auth/template-usage/overview.md for the
# mystic_auth/app split this mirrors.
# Fork identity overrides the upstream template defaults when the app Compose
# override is loaded after docker/mystic_auth/compose/docker-compose.dev.yml.
APP_NAME=Balance Sheet Analysis
BRAND_COLOR=#b5533c
# Keep this app's development network separate from other local Compose stacks.
DOCKER_SUBNET=172.29.0.0/24

# Optional app-owned policy names assigned to every verified user, in addition
# to the upstream self_service policy. Comma-separated; empty is the safe
# default. Keep app-specific policy configuration in this app-owned file.
DEFAULT_APP_POLICIES=

# Comma-separated app-owned Procrastinate modules imported by the API and worker.
PROCRASTINATE_TASK_IMPORT_PATHS=app.procrastinate_tasks.financial_refresh_tasks,app.procrastinate_tasks.analysis_notification_tasks

# Optional app-owned LLM credential; leave blank to disable grounded chat.
GROQ_API_KEY=
# All configured providers use the OpenAI-compatible chat-completions API.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_MODEL=llama-3.1-8b-instant
LLM_MAX_TOKENS=800
LLM_DAILY_CHAR_BUDGET=500000
# Optional generic outbound alert webhook. Keep this secret in real env files.
ANALYSIS_ALERT_WEBHOOK_URL=
