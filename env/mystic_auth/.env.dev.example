# Dev config: used by docker/mystic_auth/compose/docker-compose.dev.yml.
# Copy: `cp env/mystic_auth/.env.dev.example env/mystic_auth/.env.dev`, or run scripts/mystic_auth/env-tools/setup-env/setup-env.sh
# to do this (and every other mode) with fresh generated secrets in one go.
# Full field docs: docs/mystic_auth/environment/{backend,frontend,compose}.md

# ---------------------------- Change these ----------------------------
APP_NAME=MysticAuth
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth2/callback/google

FROM_EMAIL=<your_google_email>
GMAIL_APP_PASSWORD=<your_gmail_app_password>
SUPPORT_EMAIL=<your_support_email>

BUGSINK_SUPERUSER_EMAIL=admin@example.com
BUGSINK_SUPERUSER_PASSWORD=change_me_in_production

BRAND_COLOR=#b5533c

# Optional: session location (Manage Sessions "Location" column). Empty =
# disabled, shows "Unknown". See docs/mystic_auth/geolocation/overview.md.
GEOIP_DB_PATH=
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=

# Only if another project/service already uses these ports/subnet.
# See docs/mystic_auth/docker/compose-modes.md.
COMPOSE_PROJECT_NAME=mystic-auth-dev
POSTGRES_HOST_PORT=5433
VALKEY_HOST_PORT=6380
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
BUGSINK_HOST_PORT=8010
DOCKER_SUBNET=172.27.0.0/24

# Backblaze B2 backup target. Keep the application key out of git.
B2_BUCKET=
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
BACKUP_ENCRYPTION_KEY=change_me_in_development
BACKUP_UPLOAD_COMMAND=

# ---------------------------- App Config ----------------------------
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
FRONTEND_ADDITIONAL_BASE_URLS=
ACCOUNT_PURGE_GRACE_DAYS=30
AUDIT_LOG_RETENTION_DAYS=400
USER_EXPORT_MAX_ROWS=50000

# ---------------------------- Frontend Config ----------------------------
# VITE_APP_NAME/VITE_SUPPORT_EMAIL/VITE_BRAND_COLOR reuse APP_NAME/
# SUPPORT_EMAIL/BRAND_COLOR above instead of duplicating them.
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_LOGO_URL=
VITE_APP_FAVICON_URL=

# Bugsink fills this after startup. See SENTRY_DSN below.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# ---------------------------- Email / SMTP Config ----------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ENABLED=true

# ---------------------------- Error Monitoring Config ----------------------------
# Auto-filled once Bugsink starts.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Optional direct incident webhook for high-signal security alerts.
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_TOKEN=
SECURITY_ALERT_WEBHOOK_TIMEOUT_SECONDS=2

BUGSINK_SECRET_KEY=change_me_in_production_generate_your_own_random_50plus_char_key
BUGSINK_BASE_URL=http://localhost:8010
# ---------------------------- Database Config ----------------------------
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@postgres:5432/mystic_auth

# Used when running the backend locally instead of in Docker
# DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@localhost:5433/mystic_auth

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=mystic_auth
APP_DB_PASSWORD=change_me_in_production
APP_DATABASE_URL=postgresql+asyncpg://mystic_auth_app:change_me_in_production@postgres:5432/mystic_auth

# ---------------------------- Valkey Config ----------------------------
VALKEY_PASSWORD=change_me_in_production

# setup-env replaces the placeholder in both values with one generated secret.
VALKEY_URL=redis://:change_me_in_production@valkey:6379/0

# Used when running the backend locally (Valkey still runs in Docker)
# VALKEY_URL=redis://localhost:6380/0

CACHE_DEFAULT_TTL=300

# ---------------------------- Scaling Config ----------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------- JWT Config ----------------------------
SECRET_KEY=change_me_in_production_generate_your_own_random_32plus_char_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=http://localhost:8000
RESET_TOKEN_EXPIRE_MINUTES=60
ACCOUNT_DELETE_TOKEN_EXPIRE_MINUTES=60

# ---------------------------- Rate Limiter Config ----------------------------
LOGIN_LOCKOUT_TIME=300
# Raised from 5: an anonymous caller knowing only the victim's email could
# otherwise grief-lock them with a handful of wrong passwords. The per-IP
# counter below still catches real brute-forcing.
MAX_FAILED_LOGIN_ATTEMPTS=10
LOGIN_LOCKOUT_TIME_PER_IP=300
MAX_FAILED_LOGIN_ATTEMPTS_PER_IP=20
ACTION_RESERVATION_TIME=60
MAX_REQUESTS_PER_WINDOW=100
REQUEST_WINDOW_SECONDS=60

# ---------------------------- Logging Config ----------------------------
LOG_LEVEL=INFO

# ---------------------------- Environment Config ----------------------------
ENVIRONMENT=development

# ---------------------------- Reverse Proxy Config ----------------------------
TRUSTED_PROXY_IPS=
