# Only needed for local `npm run dev` outside Docker. The dev Compose stack
# never reads this file: it builds the frontend's VITE_* values from
# env/mystic_auth/.env.dev + env/app/.env.dev instead (see docker-compose.dev.yml's
# frontend service). Copy: `cp frontend/.env.example frontend/.env`, or run
# scripts/mystic_auth/env-tools/setup-env/setup-env.sh to do this (and every backend mode) with
# fresh generated secrets in one go.
# Full field docs: docs/mystic_auth/environment/frontend.md

# ---------------------------- Change these ----------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=MysticAuth
VITE_BRAND_COLOR=

# ---------------------------- Usually fine as-is ----------------------------
VITE_APP_LOGO_URL=
VITE_APP_FAVICON_URL=
VITE_SUPPORT_EMAIL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
