# ---------------------------- Python / Backend ----------------------------
# **/ prefix is required for these to match at any depth, not just directly
# under the build context root, since a bare "__pycache__/" misses nested dirs.
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
*.sqlite3
*.db
*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
# backend/logs/: rotated access-log files (real request data: paths,
# timestamps, correlation IDs). `*.log` above only matches exactly ".log",
# not rotated siblings like access.log.2026-07-19, which were previously
# getting baked into the image via `COPY backend/ .`, a real privacy leak.
backend/logs/
**/*.egg-info/
dist/
build/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
backend/.cache/
**/.dmypy.json
.coverage*
htmlcov/
**/coverage/
**/test-results/
**/playwright-report/
**/blob-report/
.venv/
venv/

# ---------------------------- Node / Frontend ----------------------------
node_modules/
frontend/node_modules/
frontend/dist/

# ---------------------------- Secrets ----------------------------
# Defense-in-depth against a future `COPY . .` baking real secrets into an
# image. Neither Dockerfile currently copies the repo root.
.env
.env.*
env/mystic_auth/.env
env/mystic_auth/.env.*
!env/mystic_auth/.env.*.example
.codex/
.local/
env/app/.env
env/app/.env.*
!env/app/.env.*.example
frontend/.env
frontend/.env.bak
frontend/.env.*
!frontend/.env.*.example
# Real credentials for local-scripts/mystic_auth/{dev,local-prod-*,prod}/create-system-user.*;
# these never need to be inside a build context, only run against a running
# container from the host.
local-scripts/**/system-user.env
# Real values a user filled in for scripts/mystic_auth/env-tools/set-env-field/
# and scripts/app/env-tools/{set-env-field,rotate-secrets}/.
scripts/mystic_auth/env-tools/set-env-field/shared-values.env
scripts/app/env-tools/set-env-field/shared-values.env
scripts/app/env-tools/rotate-secrets/fields.env
npm-debug.log
yarn-error.log
pnpm-debug.log

# ---------------------------- Docker ----------------------------
# Do not include this file inside the image.
.dockerignore
.git
.gitignore

# ---------------------------- Local Development Tools ----------------------------
.claude/
claude.md
CLAUDE.md
AGENTS.md
.project/
TODO.md
audit-evidence/

# ---------------------------- General ----------------------------
.DS_Store
*.swp
design/
SECRETS-TO-ROTATE.md
