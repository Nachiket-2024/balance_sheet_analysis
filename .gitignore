# ---------------------------- Python ----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
# Keep legacy/root-level environment files ignored after moving examples to
# env/{mystic_auth,app}/.
/.env
/.env.*
env/mystic_auth/.env.dev
env/mystic_auth/.env.*
!env/mystic_auth/.env.dev.example
!env/mystic_auth/.env.local-prod-cloudflare.example
!env/mystic_auth/.env.local-prod-ngrok.example
!env/mystic_auth/.env.local-prod-tailscale.example
!env/mystic_auth/.env.prod.example
env/app/.env.dev
env/app/.env.*
!env/app/.env.dev.example
!env/app/.env.local-prod-cloudflare.example
!env/app/.env.local-prod-ngrok.example
!env/app/.env.local-prod-tailscale.example
!env/app/.env.prod.example
*.venv/
venv/
.envrc
.Python
*.sqlite3
# Private keys and exported key containers must stay local.
*.pem
*.key
*.p12
*.pfx

# ---------------------------- Conda ----------------------------
# Not used by this project (no environment.yml) — deliberately no bare
# `env/`/`envs/` rule here, since that would also swallow the real
# config directory `env/` above.
.conda/
.condarc
*.conda

# ---------------------------- IDEs / Editors ----------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---------------------------- macOS / Linux ----------------------------
.DS_Store
Thumbs.db
*.swp

# ---------------------------- Docker ----------------------------
docker-compose.override.yml
*.pid
*.sock
*.cache

# ---------------------------- Backend ----------------------------
backend/__pycache__/
backend/*.pyc
backend/*.db
backend/.cache/

# ---------------------------- Frontend ----------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.bak
frontend/.env.*
!frontend/.env.*.example
frontend/.DS_Store
frontend/.cache/
frontend/.cache/playwright/

