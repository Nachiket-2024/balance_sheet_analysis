# Credentials used by create-system-user.{sh,ps1,bat} to non-interactively
# bootstrap the system superuser (see backend/mystic_auth/scripts/create_system_user.py).
# Copy this file to system-user.env in the same directory and fill in real
# values. system-user.env is gitignored; never commit real credentials.

SYSTEM_USER_EMAIL=system@example.com
SYSTEM_USER_NAME=System
SYSTEM_USER_PASSWORD=change_me
