# Your own shared-value fields, alongside upstream's
# scripts/mystic_auth/env-tools/set-env-field/shared-values.env.example.
# Ships empty; upstream never edits this file again.
#
# Copy to shared-values.env (gitignored) next to this file, fill in
# whichever of your own fork's fields you want set the same way in every
# env file that declares them, then run:
#   scripts/mystic_auth/env-tools/set-env-field/set-env-field.sh
#
# Only useful for a field env/app/ itself declares (see
# docs/mystic_auth/template-usage/overview.md for the mystic_auth/app
# split). Blank = skipped. Only changes a field that already exists in a
# file, same rule as the mystic_auth shared-values.env.

DEFAULT_APP_POLICIES=
