# Copy to shared-values.env (gitignored), fill in what you want set
# everywhere, then run: scripts/mystic_auth/env-tools/set-env-field/set-env-field.sh
# Blank = skipped. Only changes a field that already exists in a file.
#
# Not listed here on purpose: anything that's meant to differ per mode
# (URLs, domains, tunnel tokens, ports/subnets, ENVIRONMENT, UVICORN_WORKERS).
# Edit those directly in each env file instead. BUGSINK_SUPERUSER_PASSWORD
# is also excluded on purpose: setup-env generates that one fresh per file,
# same as POSTGRES_PASSWORD. Direct security-alert webhook URLs and tokens are
# excluded too: they normally point to different incident destinations per
# environment and should be configured in each mode's env file.

# ---------------------------- Credentials & contact ----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FROM_EMAIL=
GMAIL_APP_PASSWORD=
SUPPORT_EMAIL=
BUGSINK_SUPERUSER_EMAIL=

# One MaxMind account's credentials. See docs/mystic_auth/geolocation/overview.md.
GEOIPUPDATE_ACCOUNT_ID=
GEOIPUPDATE_LICENSE_KEY=

# Only if every mode shares one filesystem (e.g. dev + local-prod-* on the
# same machine). A remote prod server usually needs its own path instead.
GEOIP_DB_PATH=

# ---------------------------- Operational tuning ----------------------------
# Policy settings you'd usually want identical everywhere.
DB_POOL_SIZE=
DB_MAX_OVERFLOW=

JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_MINUTES=
RESET_TOKEN_EXPIRE_MINUTES=
ACCOUNT_DELETE_TOKEN_EXPIRE_MINUTES=
ACTION_RESERVATION_TIME=

CACHE_DEFAULT_TTL=

SMTP_HOST=
SMTP_PORT=
EMAIL_ENABLED=

LOGIN_LOCKOUT_TIME=
MAX_FAILED_LOGIN_ATTEMPTS=
LOGIN_LOCKOUT_TIME_PER_IP=
MAX_FAILED_LOGIN_ATTEMPTS_PER_IP=
MAX_REQUESTS_PER_WINDOW=
REQUEST_WINDOW_SECONDS=

LOG_LEVEL=

ACCOUNT_PURGE_GRACE_DAYS=
USER_EXPORT_MAX_ROWS=
