# Prod config: used by docker-compose.prod.yml. Copy to .env:
# `cp .env.prod.example .env`. Self-hosting on your own server with
# Caddy-managed TLS. See docs/mystic_auth/deployment/prod.md.
#
# Replace every <your-domain> placeholder below with your real domain
# before starting the stack. DNS must already point at this host's public
# IP, or certificate issuance fails.

# ---------------------------- App Config ----------------------------
BACKEND_BASE_URL=https://<your-domain>

# Used for OAuth, verification, and password-reset links. Put extra CORS
# origins below.
FRONTEND_BASE_URL=https://<your-domain>

# Optional, comma-separated extra CORS origins (e.g. staging alongside prod).
# FRONTEND_ADDITIONAL_BASE_URLS=https://staging.example.com,https://www.example.com

# ---------------------------- Frontend Config ----------------------------
# Leave empty: nginx proxies API calls to backend same-origin. Do not set
# this to a URL.
VITE_API_BASE_URL=
VITE_APP_NAME=Balance Sheet Analysis
# Bugsink fills this after startup. See SENTRY_DSN below.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# ---------------------------- Database Config ----------------------------
# Rotate to real values before real use.
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@postgres:5432/balance_sheet_analysis

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=balance_sheet_analysis

# ---------------------------- JWT Config ----------------------------
# Generate your own (`openssl rand -base64 32`) before real use. Must be at
# least 32 characters.
SECRET_KEY=change_me_in_production_generate_your_own_random_32plus_char_key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256
RESET_TOKEN_EXPIRE_MINUTES=60

# ---------------------------- OAuth2 / Gmail Config ----------------------------
# The CLI-created system superuser does not need Google or SMTP.
# Regular users need SMTP verification for password signup, or Google login.
# GOOGLE_REDIRECT_URI must exactly match a redirect URI registered in the
# Google Cloud Console, including scheme and trailing slash.
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_REDIRECT_URI=https://<your-domain>/auth/oauth2/callback/google

# ---------------------------- Redis Config ----------------------------
# Set a strong password for your own server.
REDIS_PASSWORD=

# If REDIS_PASSWORD is set, include it too:
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=redis://redis:6379/0

CACHE_DEFAULT_TTL=300

# ---------------------------- Email / SMTP Config ----------------------------
FROM_EMAIL=<your_google_email>
GMAIL_APP_PASSWORD=<your_gmail_app_password>
SUPPORT_EMAIL=<your_support_email>

# Only needed if not using Gmail's SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ---------------------------- App Name Config ----------------------------
APP_NAME=Balance Sheet Analysis

# ---------------------------- Rate Limiter Config ----------------------------
LOGIN_LOCKOUT_TIME=300
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME_PER_IP=300
MAX_FAILED_LOGIN_ATTEMPTS_PER_IP=20
MAX_REQUESTS_PER_WINDOW=100
REQUEST_WINDOW_SECONDS=60

# ---------------------------- Logging Config ----------------------------
LOG_LEVEL=INFO

# ---------------------------- Environment Config ----------------------------
ENVIRONMENT=production

# ---------------------------- Reverse Proxy Config ----------------------------
TRUSTED_PROXY_IPS=172.28.0.10

# ---------------------------- Server Deployment Config ----------------------------
# Caddy requests a Let's Encrypt certificate for this domain. DNS must
# already point at this host's public IP before first start.
PUBLIC_DOMAIN=<your-domain>

# Let's Encrypt sends renewal/expiry notices here. Must be a real-looking
# email address (Caddy validates the format).
ACME_EMAIL=you@example.com

# Optional. Set only if Bugsink's UI should be reachable publicly.
BUGSINK_PUBLIC_DOMAIN=

# ---------------------------- Error Monitoring Config ----------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Bugsink's own secret key (unrelated to this app's SECRET_KEY above).
# Generate your own (`openssl rand -base64 50`) before real use.
BUGSINK_SECRET_KEY=change_me_in_production_generate_your_own_random_50plus_char_key

BUGSINK_SUPERUSER_EMAIL=admin@example.com
BUGSINK_SUPERUSER_PASSWORD=change_me_in_production

# Only reachable if BUGSINK_PUBLIC_DOMAIN above is set.
BUGSINK_BASE_URL=https://<your-domain>

# ---------------------------- This app's own domain config ----------------------------
# Not part of the upstream mystic-auth template, see backend/app/llm/llm_config.py.

# Groq API key for the LLM chat feature (backend/app/llm/). Leave blank to
# disable: llm_routes.py returns a clear error rather than crashing.
GROQ_API_KEY=

# Groq's OpenAI-compatible chat completions endpoint. Optional, defaults to
# https://api.groq.com/openai/v1/chat/completions.
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Groq model name. Optional, defaults to llama-3.1-8b-instant.
# GROQ_MODEL=llama-3.1-8b-instant
