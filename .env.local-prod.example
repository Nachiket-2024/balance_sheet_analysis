# Local-prod config: used by docker-compose.local-prod.yml. Copy to .env:
# `cp .env.local-prod.example .env`. Exposes the production image/runtime
# shape via a free Cloudflare Tunnel. See
# docs/mystic_auth/deployment/local-prod.md.
#
# Preconfigured for Quick Tunnel, the default: nothing below needs changing
# to start the stack. See the Cloudflare Tunnel Config section near the
# bottom for the Named Tunnel option: a stable custom domain instead of a
# random URL that changes every restart.

# ---------------------------- App Config ----------------------------
BACKEND_BASE_URL=http://localhost

# Update to your Named Tunnel domain if you set one up.
FRONTEND_BASE_URL=http://localhost

# Optional, comma-separated extra CORS origins (e.g. staging alongside prod).
# FRONTEND_ADDITIONAL_BASE_URLS=https://staging.example.com,https://www.example.com

# ---------------------------- Frontend Config ----------------------------
# Leave empty: nginx proxies API calls to backend same-origin, so the app
# works through any tunnel URL with no updates. Do not set this to a URL.
VITE_API_BASE_URL=
VITE_APP_NAME=Balance Sheet Analysis
# Bugsink fills this after startup. See SENTRY_DSN below.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=

# ---------------------------- Database Config ----------------------------
# Rotate to real values before real use.
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@postgres:5432/balance_sheet_analysis

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=balance_sheet_analysis

# ---------------------------- JWT Config ----------------------------
# Generate your own (`openssl rand -base64 32`) before real use. Must be at
# least 32 characters.
SECRET_KEY=change_me_in_production_generate_your_own_random_32plus_char_key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256
RESET_TOKEN_EXPIRE_MINUTES=60

# ---------------------------- OAuth2 / Gmail Config ----------------------------
# The CLI-created system superuser does not need Google or SMTP.
# Regular users need SMTP verification for password signup, or Google login.
# See the Cloudflare Tunnel Config section below for the Quick Tunnel vs.
# Named Tunnel tradeoff around GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=<your_google_client_id>
GOOGLE_CLIENT_SECRET=<your_google_client_secret>
GOOGLE_REDIRECT_URI=http://localhost/auth/oauth2/callback/google

# ---------------------------- Redis Config ----------------------------
REDIS_PASSWORD=

# If REDIS_PASSWORD is set, include it too:
#   REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
REDIS_URL=redis://redis:6379/0

CACHE_DEFAULT_TTL=300

# ---------------------------- Email / SMTP Config ----------------------------
FROM_EMAIL=<your_google_email>
GMAIL_APP_PASSWORD=<your_gmail_app_password>
SUPPORT_EMAIL=<your_support_email>

# Only needed if not using Gmail's SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ---------------------------- App Name Config ----------------------------
APP_NAME=Balance Sheet Analysis

# ---------------------------- Rate Limiter Config ----------------------------
LOGIN_LOCKOUT_TIME=300
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME_PER_IP=300
MAX_FAILED_LOGIN_ATTEMPTS_PER_IP=20
MAX_REQUESTS_PER_WINDOW=100
REQUEST_WINDOW_SECONDS=60

# ---------------------------- Logging Config ----------------------------
LOG_LEVEL=INFO

# ---------------------------- Environment Config ----------------------------
ENVIRONMENT=production

# ---------------------------- Reverse Proxy Config ----------------------------
TRUSTED_PROXY_IPS=172.28.0.10

# ---------------------------- Cloudflare Tunnel Config ----------------------------
# No port forwarding, works behind NAT. Free either way. Two modes:
#
# Quick Tunnel (default, already active): leave TUNNEL_TOKEN blank. Random
# https://<words>.trycloudflare.com URL, changes every restart. Fine for
# testing. Google login needs re-registering each time the URL changes
# (see docs/mystic_auth/deployment/local-prod.md).
#
# Named Tunnel (stable URL, needs your own domain on a free Cloudflare
# account):
# 1. Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel ->
#    Cloudflared -> name it.
# 2. Copy the token from the install step into TUNNEL_TOKEN below.
# 3. Public Hostname -> Add a public hostname -> your domain/subdomain,
#    Service: HTTP, http://frontend:80.
# 4. Update FRONTEND_BASE_URL, BACKEND_BASE_URL, and (if using Google
#    login) GOOGLE_REDIRECT_URI above to that hostname.
# 5. In docker-compose.local-prod.yml's cloudflared command, swap
#    `tunnel --no-autoupdate --url http://frontend:80` for
#    `tunnel --no-autoupdate run --token ${TUNNEL_TOKEN}`.
TUNNEL_TOKEN=

# ---------------------------- Error Monitoring Config ----------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Bugsink's own secret key (unrelated to this app's SECRET_KEY above).
# Generate your own (`openssl rand -base64 50`) before real use.
BUGSINK_SECRET_KEY=change_me_in_production_generate_your_own_random_50plus_char_key

BUGSINK_SUPERUSER_EMAIL=admin@example.com
BUGSINK_SUPERUSER_PASSWORD=change_me_in_production

# Published to localhost only, not tunneled.
BUGSINK_BASE_URL=http://localhost:8010

# ---------------------------- This app's own domain config ----------------------------
# Not part of the upstream mystic-auth template, see backend/app/llm/llm_config.py.

# Groq API key for the LLM chat feature (backend/app/llm/). Leave blank to
# disable: llm_routes.py returns a clear error rather than crashing.
GROQ_API_KEY=

# Groq's OpenAI-compatible chat completions endpoint. Optional, defaults to
# https://api.groq.com/openai/v1/chat/completions.
# GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Groq model name. Optional, defaults to llama-3.1-8b-instant.
# GROQ_MODEL=llama-3.1-8b-instant
